modules = ["nodejs-24", "python-3.11", "postgresql-16"]

# Single-process deployment: build both apps, then the API server serves the
# built Books frontend itself (see artifacts/api-server/src/app.ts). PORT and
# BASE_PATH are needed at BUILD time by the Vite config; PORT at run time.
[deployment]
router = "application"
deploymentTarget = "autoscale"
# The schema push is what the old agent-managed deploy did for us: without it
# the production database never gets new tables/columns and every API call
# that touches them fails (a blank dashboard). Additive-only changes; --force
# skips drizzle's interactive prompt. Needs DATABASE_URL at build time.
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm --filter @workspace/db run push-force && NODE_ENV=production CI=true PORT=8080 BASE_PATH=/ pnpm --filter @workspace/api-server --filter @workspace/books run build"]
run = ["sh", "-c", "NODE_ENV=production PORT=8080 node --enable-source-maps artifacts/api-server/dist/index.mjs"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 18855
externalPort = 3000

[workflows]
runButton = "Start application"

# Dev: API on 8080, Vite on 18855 proxying /api to the API. Open the 18855
# preview; the API alone shows JSON.
[[workflows.workflow]]
name = "Start application"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=18855 BASE_PATH=/ pnpm --filter @workspace/books run dev"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "codegen-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pdf-streaming"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "codegen-check"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/codegen-check.sh"

[[workflows.workflow]]
name = "pdf-streaming"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-pdf-streaming.mjs"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-25868100-f13a-46c2-9511-b49c99ce0ff2"
