{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "backfill-documents": "tsx ./scripts/backfill-documents.ts",
    "backfill-split-account-ids": "tsx ./scripts/backfill-split-account-ids.ts",
    "backfill-split-accounts": "tsx ./scripts/backfill-split-accounts.ts",
    "cleanup-orphaned-uploads": "tsx ./scripts/cleanup-orphaned-uploads.ts",
    "test": "vitest run",
    "typecheck": "tsc -b ../../lib/db ../../lib/api-zod ../../lib/integrations-openai-ai-server && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.33",
    "@clerk/shared": "^4.22.1",
    "@google-cloud/storage": "^7.21.0",
    "@replit/connectors-sdk": "^0.4.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "http-proxy-middleware": "^4.1.1",
    "nodemailer": "^9.0.4",
    "pdfjs-dist": "^6.1.200",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "read-excel-file": "5.8.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.9",
    "write-excel-file": "4.1.0"
  }
}
