# Allied Power Books — environment template
#
# Copy this file to `.env` at the repo root and fill in real values. `.env`
# is git-ignored. The API server loads it automatically on startup and the
# Books app (Vite) reads the VITE_* keys from it. Variables already present
# in the process environment (Replit Secrets, a hosting dashboard, a shell
# `export`) always take precedence over this file.

# ── Required ─────────────────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgres://user:password@host:5432/books
# Port the API server (and the Vite dev server) listens on.
PORT=3000
# URL prefix the Books app is served from ("/" when it has its own domain).
BASE_PATH=/

# Clerk authentication. Publishable key is public; secret key is not.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# Only used by production builds that proxy Clerk through a custom domain.
# VITE_CLERK_PROXY_URL=https://books.example.com/api/__clerk

# ── AI (invoice reading, time-card parsing) ──────────────────────────────
# On Replit these come from the "OpenAI AI integration". Off Replit, use
# https://api.openai.com/v1 and your own OpenAI API key.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# ── File storage (uploaded documents, bill scans, email attachments) ─────
# Replit Object Storage bucket paths. Off Replit the storage client needs
# replacing (it authenticates through Replit's sidecar) — see replit.md.
PRIVATE_OBJECT_DIR=/your-bucket/.private
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# ── Books inbox (forwarded invoices, time cards, statements) ─────────────
# Any long random string. Put the SAME value in the mail provider's inbound
# webhook URL: https://<app>/api/inbound-email?token=<INBOUND_EMAIL_TOKEN>
INBOUND_EMAIL_TOKEN=change-me-to-a-long-random-string

# ── Invoice email (send invoices to customers via SMTP) ──────────────────
# SMTP_USER=apowerservices@aol.com
# SMTP_PASS=app-password

# ── Optional ─────────────────────────────────────────────────────────────
# Comma-separated hostnames allowed to call the API cross-origin. Not needed
# when the app and API share one domain.
# REPLIT_DOMAINS=books.example.com
# pino log level: trace | debug | info | warn | error
# LOG_LEVEL=info
